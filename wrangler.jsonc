{
  "name": "welfare-tools-portal",
  "main": "./worker.js",
  "compatibility_date": "2026-03-18",

  "assets": {
    "directory": "./portal-site",
    "binding": "ASSETS",
"run_worker_first": [
  "/",
  "/index.html",
  "/tools",
  "/tools/*",
  "/salary",
  "/salary/*",
  "/lottery",
  "/lottery/*",
  "/shortener",
  "/shortener/*",
  "/formatter",
  "/formatter/*",
  "/api/shorten",
  "/api/shorten/*",
  "/api/grants",
  "/api/grants/*",
  "/api/engagement",
  "/api/engagement/*",
  "/s/*"
]
  },

  "kv_namespaces": [
    {
      "binding": "SHORT_LINKS",
      "id": "9ab06d550ace49a9a0b86fbf7a15d4f2"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "welmoa-engagement",
      "database_id": "f5905234-cc68-4bbd-9540-ab9ee2b90204"
    }
  ]
}
